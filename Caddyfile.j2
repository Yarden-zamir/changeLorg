{{ host("changelorg.yarden-zamir.com") }} {
    request_header -Remote-User
    request_header -X-Auth-Request-*
    request_header -X-Forwarded-*

    handle /auth/* {
        # Agent tokens reach the app only. oauth2-proxy never receives client Authorization headers.
        request_header -Authorization
        reverse_proxy unix//{{ paths.socket }}/auth.sock {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Uri {uri}
            # The API reads these headers internally. Never expose the GitHub token to the browser.
            header_down -X-Auth-Request-*
            header_down -X-Forwarded-Access-Token
            header_down -Authorization
        }
    }

    handle {
        reverse_proxy unix//{{ paths.default_socket }}
    }
}
